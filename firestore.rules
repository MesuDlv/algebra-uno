rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Las reglas completas y estrictas de append-only se configuran y prueban en la Fase 4.
    // Durante el setup inicial permitimos lectura y escritura a usuarios autenticados.
    match /rooms/{roomId} {
      allow read, write: if request.auth != null;

      match /events/{seq} {
        allow read, write: if request.auth != null;
      }

      match /presence/{uid} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
