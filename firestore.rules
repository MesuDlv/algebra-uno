rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas de seguridad para salas de ALGEBRA UNO
    match /rooms/{roomId} {
      // Lectura y escritura permitida a usuarios autenticados (incluye sesión anónima)
      allow read, write: if request.auth != null;

      // Subcolecciones (eventos inmutables y presencia en tiempo real)
      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
