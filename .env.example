# Configuración Web de Firebase para ALGEBRA UNO
# Copia este archivo como .env.local y completa con los valores de tu consola de Firebase:
# Firebase Console -> Proyecto "algebra" -> Configuración del proyecto -> Tus apps -> Web

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=algebra-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=algebra-xxxxx
VITE_FIREBASE_STORAGE_BUCKET=algebra-xxxxx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
